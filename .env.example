# GB10-local inference. Port 9000 is reserved for Eve so the existing services
# on ports 8000, 8080, and 8081 remain untouched.
QWEN_BASE_URL=http://127.0.0.1:9000/v1
QWEN_MODEL_ID=Qwen3.6-35B-A3B-NVFP4
QWEN_API_KEY=local-only

# Durable application state and sandbox checkpoints.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=eve_hub
MONGODB_VECTOR_SEARCH_ENABLED=0

# Local embeddings (the installed nomic-embed-text model emits 768 dimensions).
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL_ID=nomic-embed-text:latest
EMBEDDING_API_KEY=local-only
EMBEDDING_DIMENSIONS=768

# Generate a secret with: openssl rand -base64 48
EVE_AUTH_SECRET=replace-me
EVE_COOKIE_SECURE=0
# Generate each passwordHash with: npm run auth:hash -- 'a strong password'
EVE_USERS_JSON='[{"id":"demo-user","email":"demo@example.com","name":"Demo User","passwordHash":"scrypt\$replace\$safely","role":"admin","tenantId":"builderbase-demo","workspaceId":"dell-nvidia-hackathon"}]'

# Public demo mode bypasses sign-in and deliberately collapses everyone into one
# demo principal. Leave it off for genuinely per-user sessions.
EVE_DEMO_PUBLIC_ACCESS=0
EVE_DEMO_TENANT_ID=builderbase-demo
EVE_DEMO_WORKSPACE_ID=dell-nvidia-hackathon
EVE_ALLOWED_ORIGIN=http://10.0.0.88:3100

# NVIDIA OpenShell durable execution.
OPENSHELL_BIN=/usr/bin/openshell
EVE_OPENSHELL_SOURCE=base
EVE_OPENSHELL_POLICY=/home/dell/eve-hub/deploy/openshell/eve-task-policy.yaml
# Leave off when OpenShell is the task workspace. Enable only if the optional
# Eve framework Docker sandbox should also be checkpointed after every turn.
EVE_FRAMEWORK_SANDBOX_CHECKPOINTS=0

# OpenClaw gateway for the paired macOS node. Keep the gateway loopback-only.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_NODE_ID=

# Optional, explicitly capability-gated online services.
SEARXNG_BASE_URL=
BRAVE_SEARCH_API_KEY=
EMAIL_PROVIDER=microsoft-graph
EMAIL_ACCESS_TOKEN=

# Required only while importing official SEC company facts.
SEC_USER_AGENT=Eve Hackathon demo@example.com
