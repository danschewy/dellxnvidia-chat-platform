[Unit]
Description=Eve durable agent runtime
After=network-online.target eve-mongo.service
Wants=network-online.target eve-mongo.service

[Service]
Type=simple
WorkingDirectory=/home/dell/eve-hub
Environment=NODE_ENV=production
ExecStart=/home/dell/eve-hub/node_modules/.bin/eve start --host 127.0.0.1 --port 4274
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
